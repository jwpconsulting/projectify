[Unit]
Description=Projectify daily cron
After=network.target postgresql.service

[Service]
Type=oneshot
User=projectify
Group=projectify
EnvironmentFile=/etc/projectify/projectify.env
WorkingDirectory={{ app_root }}
ExecStart={{ venv_path }}/bin/python ./manage.py user_event_clean
PrivateTmp=true

