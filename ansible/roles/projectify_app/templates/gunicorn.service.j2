[Unit]
Description=gunicorn daemon
# See the following page to learn about the difference
# between Requires and After:
# https://serverfault.com/a/812589
# Requires: Need to activate these units:
Requires=gunicorn.socket postgresql.service
# After: Need to start this unit after these units:
After=network.target postgresql.service

[Service]
Type=notify
NotifyAccess=main
User=projectify
Group=projectify
SupplementaryGroups=caddy
EnvironmentFile=/etc/projectify/projectify.env
WorkingDirectory={{ app_root }}
ExecStart={{ venv_path }}/bin/python -m gunicorn --config {{ gunicorn_config_file }}
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true

# TODO add hardening
# Should not change files in /usr/share/projectify
# OK to access {{ media_root }}
# Acceptable network stuff:
# - access unix socket (psql)
# - access/create unix socket (for caddy rev proxy)
# - make TCP requests to the outside world

[Install]
WantedBy=multi-user.target
