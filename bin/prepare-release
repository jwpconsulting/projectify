# Prepare a new version to be released
set -e
next_cmd=$(printf 'uv version "%s"' "$(date "+%Y.%-m.%-d")")
printf "About to run %s\nContinue? (c-c to exit)" "$next_cmd"
read -r _
eval "$next_cmd"

next_cmd=$(printf "git add %s %s %s" pyproject.toml uv.lock CHANGELOG.md)
printf "about to run %s\nContinue? (c-c to exit)" "$next_cmd"
read -r _
eval "$next_cmd"

next_cmd=$(printf 'git commit -m \"Set Projectify version to %s\"' "$(uv version --short)")
printf "about to run %s\nContinue? (c-c to exit)" "$next_cmd"
read -r _
eval "$next_cmd"

next_cmd=$(printf 'git tag %s' "$(uv version --short)")
printf "about to run %s\nContinue? (c-c to exit)" "$next_cmd"
read -r _
eval "$next_cmd"

branch_name=$(git rev-parse --abbrev-ref HEAD)
next_cmd=$(printf 'git push --set-upstream origin %s' "$branch_name")
printf "about to run %s\nContinue? (c-c to exit)" "$next_cmd"
read -r _
eval "$next_cmd"

next_cmd="git push --tags"
printf "about to run %s\nContinue? (c-c to exit)" "$next_cmd"
read -r _
eval "$next_cmd"

hyphenated_version=$(uv version --short | sed 's/\./-/g')
author=$(git config --get user.name | sed 's/ /+/g')
echo "
1. Create a pull request:

   https://github.com/jwpconsulting/projectify/compare/${branch_name}

2. Merge your pull request.
3. Create a release on GitHub:

   https://github.com/jwpconsulting/projectify/releases/new?title=$(uv version --short)&tag=$(uv version --short)

4. Create a release blog post on Projectify:

   https://www.projectifyapp.com/admin/blog/post/add/?title=New%20Projectify%20release%20$(uv version --short)&slug=projectify-release-${hyphenated_version}&author=$author&draft=True
"
